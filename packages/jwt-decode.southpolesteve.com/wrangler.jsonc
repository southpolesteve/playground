// wrangler.jsonc
{
  "name": "jwt-decoder",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "jwt-decoder.southpolesteve.com",
      "custom_domain": true
    }
  ]
}
